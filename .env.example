# Copy to .env (in this folder) or to ~/.config/jevme/.env, then fill in.
# .env is git-ignored — never commit real keys.

# Required. TypeSafe Jev (System One) — every routing/click decision. https://typesafe.ai
TYPESAFE_API_KEY=

# Recommended. Anthropic API — screenshot fallback (Haiku), writing code/replies and new tools (Opus).
# Without it, jevme falls back to the signed-in `claude` CLI (slower), if installed.
ANTHROPIC_API_KEY=

# Optional tuning (defaults shown)
# JEVME_VISION_MODEL=claude-haiku-4-5
# JEVME_CODEGEN_MODEL=claude-opus-5
# JEVME_COMMIT_CONFIDENCE=0.80
# JEVME_TEXT_PAUSE_S=0.65
# JEVME_LOCALE=en-US
# JEVME_LOG=INFO
# JEVME_SCREEN_VOCAB=1       # bias speech toward names on screen (0 = off)
